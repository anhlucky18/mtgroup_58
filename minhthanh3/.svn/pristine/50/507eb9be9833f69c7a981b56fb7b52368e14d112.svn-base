<script type="text/javascript">
    $(document).ready(function(){

        openFancybox();
        $('#popup-mt').fancybox();
        setTimeout( function() {$.fancybox.close(); },10000);
    });
    function openFancybox() {
        setTimeout( function() {$('#popup-mt').trigger('click'); });
    };

</script>
